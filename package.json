{
	"name": "@oarkflow/lithe",
	"version": "1.1.1",
	"private": false,
	"type": "module",
	"description": "Lithe v1.1: a zero-dependency TypeScript-first compiler, fine-grained frontend/full-stack framework built on browser APIs and Node.js built-ins.",
	"license": "MIT",
	"author": "oarkflow",
	"keywords": [
		"typescript",
		"frontend",
		"framework",
		"reactive",
		"signals",
		"jsx",
		"compiler",
		"ssr",
		"fine-grained",
		"zero-dependency"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oarkflow/lithe-ts.git"
	},
	"homepage": "https://github.com/oarkflow/lithe-ts#readme",
	"bugs": {
		"url": "https://github.com/oarkflow/lithe-ts/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.6.0"
	},
	"bin": {
		"lithe": "./cli/lithe"
	},
	"files": [
		"src",
		"cli",
		"tools",
		"types",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node --experimental-strip-types --trace-warnings --test tests/*.test.ts",
		"check": "node --experimental-strip-types --trace-warnings cli/lithe.ts sourcecheck .",
		"build": "node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=core",
		"build:lib": "node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=core",
		"build:runtime": "node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=runtime",
		"build:full": "node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=full",
		"build:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts build examples/todo",
		"dev": "node --experimental-strip-types --trace-warnings cli/lithe.ts dev examples/todo",
		"dev:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts dev examples/todo",
		"analyze:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts analyze examples/todo",
		"benchmark": "node --experimental-strip-types --trace-warnings benchmarks/reactive.ts",
		"typecheck": "node --experimental-strip-types --trace-warnings cli/lithe.ts sourcecheck .",
		"typecheck:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts typecheck examples/todo",
		"doctor:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts doctor examples/todo",
		"test:browser": "node --experimental-strip-types --trace-warnings --test tests/browser.test.ts tests/preview.test.ts",
		"types:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts types examples/todo",
		"prerender:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts prerender examples/todo",
		"validate": "node --experimental-strip-types --trace-warnings cli/lithe.ts sourcecheck . && node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=core && node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=runtime && node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=full && node --experimental-strip-types --trace-warnings --test tests/*.test.ts && node --experimental-strip-types --trace-warnings cli/lithe.ts typecheck examples/todo && node --experimental-strip-types --trace-warnings cli/lithe.ts check examples/todo && node --experimental-strip-types --trace-warnings cli/lithe.ts build examples/todo",
		"validate:lib": "node --experimental-strip-types --trace-warnings cli/lithe.ts sourcecheck . && node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=core && node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=runtime && node --experimental-strip-types --trace-warnings tools/build-library.ts --mode=full && node --experimental-strip-types --trace-warnings --test tests/release.test.ts tests/typescript-first.test.ts tests/compiler.test.ts tests/plugins.test.ts",
		"validate:demo": "node --experimental-strip-types --trace-warnings cli/lithe.ts typecheck examples/todo && node --experimental-strip-types --trace-warnings cli/lithe.ts check examples/todo && node --experimental-strip-types --trace-warnings cli/lithe.ts build examples/todo",
		"sourcecheck": "node --experimental-strip-types --trace-warnings cli/lithe.ts sourcecheck .",
		"check:framework": "node --experimental-strip-types --trace-warnings cli/lithe.ts check .",
		"pack:npm": "npm run build:full && npm pack ./dist/lithe-package-full",
		"publish:npm": "npm run validate:lib && npm publish ./dist/lithe-package-full --access public"
	},
	"dependencies": { },
	"devDependencies": { },
	"types": "./types/lithe.d.ts",
	"source": "./src/runtime/index.ts",
	"exports": {
		".": "./src/runtime/index.ts",
		"./core": "./src/core/index.ts",
		"./dom": "./src/dom/index.ts",
		"./jsx-runtime": "./src/dom/jsx-runtime.ts",
		"./dom/jsx-runtime": "./src/dom/jsx-runtime.ts",
		"./jsx-dev-runtime": "./src/dom/jsx-dev-runtime.ts",
		"./dom/jsx-dev-runtime": "./src/dom/jsx-dev-runtime.ts",
		"./forms": "./src/forms/index.ts",
		"./router": "./src/router/index.ts",
		"./i18n": "./src/i18n/index.ts",
		"./style": "./src/style/index.ts",
		"./server": "./src/server/index.ts",
		"./devtools": "./src/devtools/index.ts",
		"./compiler": "./src/compiler/index.ts",
		"./experimental": "./src/experimental/index.ts",
		"./plugins": "./src/plugins/index.ts",
		"./vite": "./src/plugins/vite.ts",
		"./rollup": "./src/plugins/rollup.ts",
		"./babel": "./src/plugins/babel.ts",
		"./tailwind": "./src/plugins/tailwind.ts",
		"./data": "./src/data/index.ts",
		"./collection": "./src/collection/index.ts",
		"./ui": "./src/ui/index.ts",
		"./virtual": "./src/virtual/index.ts",
		"./grid": "./src/grid/index.ts",
		"./image": "./src/image/index.ts",
		"./animation": "./src/animation/index.ts",
		"./worker": "./src/worker/index.ts",
		"./offline": "./src/offline/index.ts",
		"./sync": "./src/sync/index.ts",
		"./interop": "./src/interop/index.ts",
		"./observability": "./src/observability/index.ts",
		"./permissions": "./src/permissions/index.ts",
		"./testing": "./src/testing/index.ts",
		"./head": "./src/head/index.ts",
		"./app": "./src/app/index.ts",
		"./rpc": "./src/server/index.ts"
	}
}
