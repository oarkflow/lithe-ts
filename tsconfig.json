{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "jsx": "preserve",
    "jsxImportSource": "lithe",
    "baseUrl": ".",
    "paths": {
      "lithe": ["./types/lithe.d.ts", "./src/index.ts"],
      "lithe/*": ["./types/lithe.d.ts", "./src/*"],
      "@lithe/*": ["./types/lithe.d.ts", "./src/*"]
    },
    "allowJs": false,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts",
    "cli/**/*.ts",
    "tests/**/*.ts",
    "benchmarks/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/dist/**",
    ".lithe/**",
    "benchmarks/node_modules/**"
  ]
}
