{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "jsx": "preserve",
    "allowJs": false,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts",
    "cli/**/*.ts",
    "tests/**/*.ts",
    "benchmarks/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/dist/**",
    ".lithe/**"
  ]
}
